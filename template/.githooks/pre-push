#!/bin/sh
# release-kit: pre-push guard. Blocks pushing straight to, force pushing or
# deleting the protected branches, and moving or deleting a release tag
# (see scripts/release-kit/guard.mjs; RELEASE_KIT_ALLOW_DIRECT_PUSH=1 overrides, logged).
exec node "$(git rev-parse --show-toplevel)/scripts/release-kit/guard.mjs" "$@"
